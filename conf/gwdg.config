// GWDG (Göttingen) HPC profile.
// Cluster-specific values come from environment variables so this file has
// no hard-coded partition/account/paths.
//
// Env vars (typically set by scripts/run_gwdg.sh; all optional):
//   GWDG_PARTITION       SLURM partition. Default: scc-cpu (SCC).
//                        NHR users override to standard96 / standard96s.
//   GWDG_WORKSPACE       Path to a workspace, used as Nextflow workDir AND as
//                        the results outdir (keeps bulky outputs off the small
//                        home quota). Create: ws_allocate -F ceph-ssd genome-skim 30
//   APPTAINER_CACHEDIR   Where to cache pulled .sif images (use the workspace)
//   GUROBI_LIC           Path to a Gurobi licence file (default ~/gurobi.lic).
//                        Bound into the RESPECT container at /opt/gurobi/gurobi.lic.
//   GWDG_ACCOUNT         Optional. Project-specific usernames only have one
//                        Slurm account so --account is usually unnecessary -
//                        we only inject it when this var is explicitly set.
//   GWDG_CLUSTER_OPTS    Extra raw `sbatch` options appended verbatim.
//   GWDG_BIND            Override default Apptainer bind list.
//
// Implementation note: Nextflow's strict config parser (≥24.04) forbids
// top-level `def` and bare assignments interleaved with config blocks, so
// every value below is computed by an immediately-invoked closure. Verbose
// but unavoidable. The first closure also emits warnings for missing vars.

workDir = {
    def w = System.getenv('GWDG_WORKSPACE')
    if (!w) {
        System.err.println('[gwdg profile] WARNING: GWDG_WORKSPACE is not set - falling back to ./work (slow on $HOME).')
    }
    (w && !w.isEmpty()) ? "${w}/work" : "${projectDir}/work"
}()

params {
    // Publish results onto the workspace, not the repo (which lives under the
    // small HPC home quota - publishing tens of GB of outputs there fills it
    // and crashes the run mid-flight). Falls back to the repo-local default
    // only when no workspace is set; a CLI --outdir still overrides this.
    outdir = {
        def w = System.getenv('GWDG_WORKSPACE')
        if (!w) {
            System.err.println('[gwdg profile] WARNING: GWDG_WORKSPACE is not set - publishing results under ./results (may overrun the home quota on real data).')
        }
        (w && !w.isEmpty()) ? "${w}/results" : "${projectDir}/results"
    }()
}

executor {
    name        = 'slurm'
    queueSize   = 50
    submitRateLimit = '10 sec'
}

process {
    // Each task runs as its own SLURM job on a compute node, where the
    // apptainer module is NOT inherited from the login shell (PATH does not
    // carry over). Load it per-job so Nextflow can find the `apptainer`
    // binary; without this every containerised task dies with
    // "env: 'apptainer': No such file or directory" (exit 127). The fallback
    // re-sources the profile in the rare case the module function isn't
    // exported into the job environment.
    beforeScript   = 'module load apptainer 2>/dev/null || { source /etc/profile; module load apptainer; }'
    queue          = { System.getenv('GWDG_PARTITION') ?: 'scc-cpu' }()
    clusterOptions = {
        // GWDG project-specific usernames have a single Slurm account, so
        // we don't pass --account by default. Only inject if the user has
        // explicitly set GWDG_ACCOUNT (legacy personal usernames with
        // multiple project memberships).
        def acc   = System.getenv('GWDG_ACCOUNT')
        def extra = System.getenv('GWDG_CLUSTER_OPTS') ?: ''
        ([acc ? "--account=${acc}" : null, extra].findAll { it }).join(' ')
    }()
    cpus           = 4
    memory         = '8 GB'
    time           = '2h'
    errorStrategy  = { task.exitStatus in 130..143 ? 'retry' : 'terminate' }
    maxRetries     = 1
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = {
        def c = System.getenv('APPTAINER_CACHEDIR')
        if (c) return c
        def w = System.getenv('GWDG_WORKSPACE')
        w ? "${w}/apptainer_cache" : null
    }()
    runOptions = {
        // Documented GWDG Apptainer bind list (same for SCC and NHR per the
        // docs; no documented SCC/NHR difference). Only bind paths that exist
        // on EVERY compute node: apptainer FATALs if a bind source is missing,
        // and this closure runs on the login node so it cannot probe compute
        // nodes. Earlier we added /home and /scratch-scc, which do not exist on
        // scc-cpu compute nodes and killed every task with
        // "mount /scratch-scc doesn't exist". $HOME lives under /user, so /home
        // is unnecessary anyway. Override entirely with GWDG_BIND if needed.
        // Source: https://docs.hpc.gwdg.de/software_stacks/list_of_modules/apptainer/index.html
        def partition  = System.getenv('GWDG_PARTITION') ?: 'scc-cpu'
        def sccDefault = '/mnt,/local,/user,/projects,/scratch,$HOME,$TMPDIR,$PROJECT'
        def nhrDefault = '/mnt,/local,/user,/projects,/scratch,$HOME,$TMPDIR,$PROJECT'
        def bindList   = System.getenv('GWDG_BIND') ?: (partition.startsWith('scc-') ? sccDefault : nhrDefault)
        def lic        = System.getenv('GUROBI_LIC') ?: "${System.getProperty('user.home')}/gurobi.lic"
        def gurobi     = new File(lic).exists() ? ",${lic}:/opt/gurobi/gurobi.lic:ro" : ''
        // Inject the GWDG caching proxy INTO the container. Nextflow launches
        // apptainer via `env -` (clears the host env) and we add --cleanenv, so
        // the proxy the `--constraint=inet` node exposes (and any
        // APPTAINERENV_* exported on the login node) never reaches inside the
        // container. DB downloads (BUSCO/MITO/MITOS2 reference data) and
        // RESPECT's Gurobi WLS licence checkout then fail with
        // "Network is unreachable". Passing the proxy as apptainer --env args
        // works because command-line args survive `env -`. Every job requests
        // --constraint=inet so the proxy is reachable; offline tools ignore it.
        def proxy      = System.getenv('GWDG_PROXY') ?: 'http://www-cache.gwdg.de:3128'
        "--bind ${bindList}${gurobi} --cleanenv --env http_proxy=${proxy} --env https_proxy=${proxy} --env ftp_proxy=${proxy}"
    }()
}
