// Test set: five annelid genome skims subsampled from ENA (see
// assets/test_manifest.tsv). Combine with an engine profile, e.g.
// `-profile test,podman`. Populate test_data/ first with
// `scripts/fetch_test_data.sh --manifest assets/test_manifest.tsv`.
// The pipeline defaults (Annelida MitoZ clade, invertebrate mitochondrial
// code 5) already fit these samples, so nothing else is overridden here.
params {
    input = "${projectDir}/assets/samplesheet_test.csv"
}
