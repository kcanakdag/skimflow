// Tiny real test inputs. Combine with an engine profile, e.g. `-profile test,podman`.
// Run scripts/fetch_test_data.sh first to populate test_data/.
params {
    input = "${projectDir}/assets/samplesheet_test.csv"

    // The test sample (Bostrychus sinensis) is a teleost: vertebrate
    // mitochondrial code 2 and the Chordata MitoZ clade.
    mitoz_clade         = 'Chordata'
    mitoz_genetic_code  = 2
    mitos2_genetic_code = 2
}
