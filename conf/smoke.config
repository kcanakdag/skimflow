// Smoke test: one real fish skim subsampled from ENA (DRR148567). Combine with
// an engine profile, e.g. `-profile smoke,podman`. Populate test_data/ first
// with `scripts/fetch_test_data.sh` (no arguments).
params {
    input = "${projectDir}/assets/samplesheet_smoke.csv"

    // The smoke sample (Bostrychus sinensis) is a teleost: vertebrate
    // mitochondrial code 2 and the Chordata MitoZ clade.
    mitoz_clade         = 'Chordata'
    mitoz_genetic_code  = 2
    mito_seed_gencode   = 2
    mitos2_genetic_code = 2
}
