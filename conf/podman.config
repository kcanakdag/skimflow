// Podman engine.
//
// Gurobi licence: RESPECT needs a Gurobi licence at runtime. We bind the
// host file (env GUROBI_LIC, default ~/gurobi.lic) into the container at
// /opt/gurobi/gurobi.lic. If the file is absent, the bind is skipped and
// RESPECT will fail with a clear "no licence" message - fix by getting a
// free academic WLS licence at https://www.gurobi.com/academia/.

podman {
    enabled    = true
    runOptions = {
        def lic = System.getenv('GUROBI_LIC') ?: "${System.getProperty('user.home')}/gurobi.lic"
        def opt = new File(lic).exists() ? "--volume ${lic}:/opt/gurobi/gurobi.lic:ro" : ''
        ("--userns=keep-id ${opt}").trim()
    }()
}

// Local-resource caps. The module defaults are tuned for GWDG (16 cores,
// 32 GB per task); on a laptop those 32 GB requests exceed the local executor
// pool and cannot be scheduled. Trim the heavy steps here so the documented
// local podman commands (short reads, --kraken2_db, --long_reads) run
// comfortably on ~16 cores / 30 GB. MEGAHIT and Flye are memory-frugal at skim
// scale; DECONTAM caps at 24 GB so a real ~16 GB kraken2 DB still fits in RAM.
process {
    withName: ASSEMBLY { cpus = 6; memory = '24 GB' }
    withName: MARKERS  { cpus = 4; memory = '8 GB' }
    withName: DECONTAM { cpus = 6; memory = '24 GB' }
    withName: FLYE     { cpus = 6; memory = '24 GB' }
    withName: LR_QC    { cpus = 1; memory = '4 GB' }
}
