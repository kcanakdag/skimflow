// Local-resource caps, shared by the podman, docker and apptainer engine
// profiles (not by gwdg, which schedules through SLURM).
//
// The module defaults are tuned for GWDG (16 cores, 32 GB per task, retries
// scaling memory by task.attempt). On a workstation those requests exceed the
// local executor pool (executor.memory in nextflow.config) and Nextflow aborts
// with "Process requirement exceeds available memory". resourceLimits clamps
// every request, including the retry-scaled ones of RESPECT and MITOGENOME,
// to the pool. Keep the cpus and memory values in step with the executor block.
process.resourceLimits = [
    cpus  : Runtime.runtime.availableProcessors(),
    memory: 24.GB,
    time  : 24.h
]

// Trim the heavy steps so the documented local commands (short reads,
// --kraken2_db, --long_reads) run comfortably on ~16 cores / 30 GB. MEGAHIT
// and Flye are memory-frugal at skim scale; DECONTAM caps at 24 GB so a real
// ~16 GB kraken2 DB still fits in RAM.
process {
    withName: ASSEMBLY { cpus = 6; memory = '24 GB' }
    withName: MARKERS  { cpus = 4; memory = '8 GB' }
    withName: DECONTAM { cpus = 6; memory = '24 GB' }
    withName: FLYE     { cpus = 6; memory = '24 GB' }
    withName: LR_QC    { cpus = 1; memory = '4 GB' }
}
