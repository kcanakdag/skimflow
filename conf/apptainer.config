// Apptainer engine - generic, suitable for laptop runs.
// The gwdg profile overrides this with the cluster-specific bind list.
//
// Gurobi licence: bound at /opt/gurobi/gurobi.lic when GUROBI_LIC (or
// ~/gurobi.lic) exists. RESPECT looks here automatically.

apptainer {
    enabled    = true
    autoMounts = true
    runOptions = {
        def lic = System.getenv('GUROBI_LIC') ?: "${System.getProperty('user.home')}/gurobi.lic"
        new File(lic).exists() ? "--bind ${lic}:/opt/gurobi/gurobi.lic:ro" : ''
    }()
}
