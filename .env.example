# Local shell settings for GWDG runs. Copy to .env, edit paths, then run:
#   set -a; source .env; set +a

# Gurobi WLS licence file used by RESPECT. Do not commit the licence itself.
GUROBI_LIC=$HOME/gurobi.lic

# GWDG defaults for SCC users.
GWDG_PARTITION=scc-cpu
GWDG_WS_FS=ceph-ssd
GWDG_WS_NAME=genome-skim
GWDG_WS_DAYS=30

# Academic Gurobi WLS needs HTTPS access during RESPECT runs. On GWDG,
# --constraint=inet enables limited internet access in Slurm jobs; the
# proxy variables are passed into Apptainer containers via APPTAINERENV_*.
GWDG_CLUSTER_OPTS="--constraint=inet"
GWDG_PROXY=http://www-cache.gwdg.de:3128
APPTAINERENV_http_proxy=http://www-cache.gwdg.de:3128
APPTAINERENV_https_proxy=http://www-cache.gwdg.de:3128

# Optional kraken2 database for short-read decontamination.
KRAKEN2_DB=/path/to/kraken2_db

# Optional pre-downloaded MITOS2 reference data directory.
MITOS2_REFDIR=/path/to/mitos.db.0.3
