// Top-level config for the genome-skim assembly pipeline.
//
// Profile design:
//   - Engine profiles (combinable): podman, docker, apptainer
//   - Site profile:                 gwdg (slurm + apptainer + GWDG bind mounts)
//   - Convenience:                  test  (5-annelid ENA subsample)
//                                   smoke (1-sample real ENA fish subsample, DRR148567)
//
// Examples:
//   nextflow run . -profile podman           # local dev, podman engine
//   nextflow run . -profile docker           # local dev, docker engine
//   nextflow run . -profile apptainer        # local dev, apptainer engine
//   nextflow run . -profile test,podman      # tiny test inputs, podman
//   nextflow run . -profile gwdg             # SLURM + apptainer on GWDG

manifest {
    name        = 'skimflow'
    author      = 'Kerem Canakdag'
    homePage    = 'https://github.com/kcanakdag/skimflow'
    description = 'Nextflow pipeline that turns genome skims (Illumina short reads, optionally long reads) into a RESPECT genome size/coverage estimate, MEGAHIT/Flye assemblies, annotated mitogenomes, BUSCO scores, mitochondrial phylogenies and a MultiQC report.'
    mainScript  = 'main.nf'
    nextflowVersion = '>=24.04'
}

params {
    // Three ways to feed input (mutually exclusive). Pick one:
    //   --input  <samplesheet.csv>   multi-sample, full metadata, the long way
    //   --r1 <R1.fq.gz> [--r2 <R2.fq.gz>]   single-sample short-read shortcut
    //   --long_reads <reads.fq.gz>   single-sample long-read-only shortcut
    // With --r1, sample_id is derived from the R1 filename unless overridden.
    input             = null
    r1                = null
    r2                = null
    sample_id         = null            // optional override when using --r1/--r2
    species           = null            // optional, defaults to sample_id
    expected_size     = null            // optional bp count for the report sanity check
    outdir            = "${projectDir}/results"
    // The gwdg profile overrides this to $GWDG_WORKSPACE/results so bulky
    // outputs land on the large workspace filesystem, never the small HPC
    // home quota (see conf/gwdg.config). A CLI --outdir still wins over both.

    // fastp's trimmed FASTQs are large intermediates read from work/ by the
    // downstream steps, so they are NOT published by default. Set true to keep
    // the trimmed reads as a deliverable under results/read_qc/.
    save_trimmed_reads = false

    // Genome size + coverage (RESPECT).
    // RESPECT runs in a custom container (see containers/respect/Containerfile)
    // because it depends on Gurobi, which is not on biocontainers. Build the
    // image once and either tag it `local/respect:0.2` or set this param.
    respect_container = 'local/respect:0.2'

    // When RESPECT runs but produces no estimate (it reports NA), the task
    // warns and continues by default. Set true to fail the task instead.
    respect_strict    = false

    // The academic Gurobi WLS licence allows 2 sessions at a time; more
    // parallel RESPECT tasks are refused. Raise for a larger licence.
    respect_max_forks       = 2
    // How often a task waits 5 min and retries after a refused session.
    respect_licence_retries = 6

    // Skip RESPECT entirely - useful when no Gurobi licence is available
    // yet (the rest of the pipeline still produces a report).
    skip_respect      = false

    // Mitogenome extraction (GetOrganelle).
    organelle_type = 'animal_mt'     // animal_mt|fungus_mt|embplant_mt|embplant_pt|other_pt|...
    organelle_db   = null            // optional path to a pre-downloaded GetOrganelle DB; if null, downloaded on first run
    mito_seed      = null            // optional seed FASTA (close relative, e.g. a COX1 barcode) for samples without a samplesheet mito_seed; null => GetOrganelle default seeds
    mito_seed_library = null         // optional multi-species seed FASTA (e.g. COX1 per species); each sample uses records whose name matches its species_id or sample_id, else its genus
    mito_self_seed    = true          // samples without a given seed: find their own mito contigs in the MEGAHIT assembly and seed GetOrganelle with them
    mito_seed_ref     = "${projectDir}/assets/mito_pcg_annelida.faa"   // mito protein queries for self-seeding
    mito_seed_gencode = 5             // genetic code for the tblastn search (5 invertebrate mito, 2 vertebrate mito)
    mito_seed_min_contig = 500        // ignore shorter contigs in the self-seed search
    mito_seed_depth_frac = 0.2        // keep clean hit contigs with at least this fraction of the deepest one's depth
    mito_keep_all_reads = true       // pass --reduce-reads-for-coverage inf --max-reads inf (see modules/mitogenome.nf)

    // Mitogenome annotation (runs on GetOrganelle FASTA output).
    mitogenome_topology   = 'auto'    // auto|linear|circular
    mitoz_container       = 'docker.io/guanliangmeng/mitoz:3.6'  // fully-qualified: podman rejects bare short-names
    // MitoZ --clade picks the CDS reference proteins. Valid values: Chordata,
    // Arthropoda, Echinodermata, Annelida-segmented-worms, Bryozoa, Mollusca,
    // Nematoda, Nemertea-ribbon-worms, Porifera-sponges. The default fits the
    // thesis taxa (Syllidae). Vertebrates need Chordata with genetic code 2.
    mitoz_clade           = 'Annelida-segmented-worms'
    mitoz_genetic_code    = 5
    mitos2_container      = 'quay.io/biocontainers/mitos:2.1.10--pyhdfd78af_0'
    mitos2_refdir         = null      // optional directory containing MITOS2 reference data; null => downloaded on first run
    mitos2_refseqver      = 'refseq89m'
    mitos2_genetic_code   = 5
    mitos2_extra_args     = '--noplots'

    // Per-gene cross-species FASTA harvesting (MITO_GENES). Runs the two
    // bin/ python scripts; stdlib only. Use the full python image (not -slim):
    // Nextflow's task wrapper needs `ps` (procps), which the slim image omits.
    gene_container        = 'docker.io/library/python:3.12'

    // Marker extraction (BUSCO).
    busco_lineage  = 'metazoa_odb10' // metazoa_odb10|eukaryota_odb10|arthropoda_odb10|...
    busco_db       = null            // optional path to a pre-downloaded BUSCO download dir; if null, downloaded on first run

    // Decontamination (kraken2). Optional - only runs when a DB is provided.
    kraken2_db            = null            // path to a kraken2 DB directory; null => decontam skipped

    // Long-read assembly (Flye). Long-only direct mode plus per-row CSV columns.
    long_reads            = null            // single-sample long-read FASTQ (long-only direct mode)
    lr_type               = 'nanopore'      // nanopore | pacbio (default tech for long samples)
    flye_mode             = null            // override Flye read flag (e.g. --nano-raw, --pacbio-hifi); null => derive from lr_type
    filtlong_min_length   = 1000            // Filtlong --min_length
    filtlong_keep_percent = 90              // Filtlong --keep_percent

    // Short-read assembler (MEGAHIT).
    megahit_preset        = 'meta-sensitive' // MEGAHIT --presets for host + microbial skim mixtures

    // Phylogenetics (MAFFT -> trimAl -> IQ-TREE) on the harvested per-gene
    // FASTAs. Runs both sequence types: nt (13 PCG + 2 rRNA) and aa (13 PCG),
    // each as a partitioned supermatrix species tree plus optional per-gene
    // trees. Fail-soft: any tree with <4 taxa is skipped, not fatal.
    skip_phylo              = false
    phylo_gene_trees        = true    // also build a per-gene tree, not just the supermatrix
    // Genes aligned in fewer than phylo_min_taxa_per_gene samples are dropped
    // (logged to stderr); in kept genes, samples missing that gene are
    // gap-padded. Set to 3 to keep genes missing from one taxon.
    phylo_min_taxa_per_gene = 4
    mafft_container         = 'quay.io/biocontainers/mafft:7.525--h031d066_1'
    mafft_args              = '--auto'
    trimal_container        = 'quay.io/biocontainers/trimal:1.5.1--h9948957_0'
    trimal_mode             = 'automated1'  // trimAl method flag: automated1|gappyout|strict|strictplus
    iqtree_container        = 'quay.io/biocontainers/iqtree:2.3.6--h503566f_1'
    iqtree_bootstrap        = 1000    // UFBoot replicates (-B)
    iqtree_alrt             = 1000    // SH-aLRT replicates (-alrt)
    // Fixed IQ-TREE random seed (-seed); with a fixed thread count (-T) this
    // makes UFBoot/SH-aLRT support values repeatable across re-runs.
    iqtree_seed             = 12345
}

// Default executor settings - overridden by the gwdg profile.
// `memory` is the total pool the local executor schedules tasks against.
// 24 GB fits a 30 GB workstation with headroom for MEGAHIT assembly; users
// on bigger or smaller boxes can override with `-process.executor.memory`
// or in their own profile.
executor {
    name   = 'local'
    cpus   = Runtime.runtime.availableProcessors()
    memory = '24 GB'
}

process {
    cpus          = 1
    memory        = '2 GB'
    time          = '1h'
    errorStrategy = 'terminate'
}

profiles {
    podman    { includeConfig 'conf/podman.config' }
    docker    { includeConfig 'conf/docker.config' }
    apptainer { includeConfig 'conf/apptainer.config' }
    gwdg      { includeConfig 'conf/gwdg.config' }
    test      { includeConfig 'conf/test.config' }
    smoke     { includeConfig 'conf/smoke.config' }
}

// Reports.
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_timeline.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_trace.txt"
}

workflow.onComplete = {
    println "Pipeline finished: ${workflow.success ? 'OK' : 'FAILED'}"
    println "Results in: ${params.outdir}"
}
