// Top-level config for the genome-skim assembly pipeline.
//
// Profile design:
//   - Engine profiles (combinable): podman, docker, apptainer
//   - Site profile:                 gwdg (slurm + apptainer + GWDG bind mounts)
//   - Convenience:                  test (tiny synthetic data)
//
// Examples:
//   nextflow run . -profile podman           # local dev, podman engine
//   nextflow run . -profile docker           # local dev, docker engine
//   nextflow run . -profile apptainer        # local dev, apptainer engine
//   nextflow run . -profile test,podman      # tiny test inputs, podman
//   nextflow run . -profile gwdg             # SLURM + apptainer on GWDG

manifest {
    name        = 'skimflow'
    author      = 'Kerem Canakdag'
    homePage    = 'https://github.com/kcanakdag/skimflow'
    description = 'Nextflow pipeline that turns Illumina genome skims into assemblies, mitogenomes, and BUSCO marker scores.'
    mainScript  = 'main.nf'
    nextflowVersion = '>=24.04'
}

params {
    // Two ways to feed input. Pick one:
    //   --input  <samplesheet.csv>   multi-sample, full metadata, the long way
    //   --r1 <R1.fq.gz> [--r2 <R2.fq.gz>]   single-sample shortcut
    // With --r1, sample_id is derived from the R1 filename unless overridden.
    input             = null
    r1                = null
    r2                = null
    sample_id         = null            // optional override when using --r1/--r2
    species           = null            // optional, defaults to sample_id
    expected_size     = null            // optional bp count for the report sanity check
    outdir            = "${projectDir}/results"

    // Genome size + coverage (RESPECT).
    // RESPECT runs in a custom container (see containers/respect/Containerfile)
    // because it depends on Gurobi, which is not on biocontainers. Build the
    // image once and either tag it `local/respect:0.2` or set this param.
    respect_container = 'local/respect:0.2'

    // Skip RESPECT entirely - useful when no Gurobi licence is available
    // yet (the rest of the pipeline still produces a report).
    skip_respect      = false

    // Mitogenome extraction (GetOrganelle).
    organelle_type = 'animal_mt'     // animal_mt|fungus_mt|embplant_mt|embplant_pt|other_pt|...
    organelle_db   = null            // optional path to a pre-downloaded GetOrganelle DB; if null, downloaded on first run

    // Mitogenome annotation (runs on GetOrganelle FASTA output).
    mitogenome_topology   = 'auto'    // auto|linear|circular
    mitoz_container       = 'guanliangmeng/mitoz:3.6'
    mitoz_clade           = 'Arthropoda'
    mitoz_genetic_code    = 5
    mitos2_container      = 'quay.io/biocontainers/mitos:2.1.10--pyhdfd78af_0'
    mitos2_refdir         = null      // optional directory containing MITOS2 reference data; null => downloaded on first run
    mitos2_refseqver      = 'refseq89m'
    mitos2_genetic_code   = 5
    mitos2_extra_args     = '--noplots'

    // Marker extraction (BUSCO).
    busco_lineage  = 'metazoa_odb10' // metazoa_odb10|eukaryota_odb10|arthropoda_odb10|...
    busco_db       = null            // optional path to a pre-downloaded BUSCO download dir; if null, downloaded on first run

    // Decontamination (kraken2). Optional - only runs when a DB is provided.
    kraken2_db            = null            // path to a kraken2 DB directory; null => decontam skipped

    // Long-read assembly (Flye). Long-only direct mode plus per-row CSV columns.
    long_reads            = null            // single-sample long-read FASTQ (long-only direct mode)
    lr_type               = 'nanopore'      // nanopore | pacbio (default tech for long samples)
    flye_mode             = null            // override Flye read flag (e.g. --nano-raw, --pacbio-hifi); null => derive from lr_type
    filtlong_min_length   = 1000            // Filtlong --min_length
    filtlong_keep_percent = 90              // Filtlong --keep_percent

    // Short-read assembler (MEGAHIT).
    megahit_preset        = 'meta-sensitive' // MEGAHIT --presets for host + microbial skim mixtures
}

// Default executor settings - overridden by the gwdg profile.
// `memory` is the total pool the local executor schedules tasks against.
// 24 GB fits a 30 GB workstation with headroom for MEGAHIT assembly; users
// on bigger or smaller boxes can override with `-process.executor.memory`
// or in their own profile.
executor {
    name   = 'local'
    cpus   = Runtime.runtime.availableProcessors()
    memory = '24 GB'
}

process {
    cpus          = 1
    memory        = '2 GB'
    time          = '1h'
    errorStrategy = 'terminate'
}

profiles {
    podman    { includeConfig 'conf/podman.config' }
    docker    { includeConfig 'conf/docker.config' }
    apptainer { includeConfig 'conf/apptainer.config' }
    gwdg      { includeConfig 'conf/gwdg.config' }
    test      { includeConfig 'conf/test.config' }
}

// Reports.
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_timeline.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_trace.txt"
}

workflow.onComplete = {
    println "Pipeline finished: ${workflow.success ? 'OK' : 'FAILED'}"
    println "Results in: ${params.outdir}"
}
